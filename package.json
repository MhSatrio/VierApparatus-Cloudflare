{
  "name": "vierapparatus",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "indexnow": "tsx --env-file-if-exists=.env.local --tsconfig scripts/tsconfig.json scripts/indexnow.ts",
    "seo:audit": "node scripts/seo-audit.mjs",
    "db:migrate": "tsx --env-file-if-exists=.env.local --tsconfig scripts/tsconfig.json scripts/db-migrate.ts",
    "admin:bootstrap": "tsx --env-file-if-exists=.env.local --tsconfig scripts/tsconfig.json scripts/admin-bootstrap.ts",
    "admin:reset-password": "tsx --env-file-if-exists=.env.local --tsconfig scripts/tsconfig.json scripts/admin-reset-password.ts",
    "content:seed": "tsx --env-file-if-exists=.env.local --tsconfig scripts/tsconfig.json scripts/seed-content.ts",
    "modules:seed": "tsx --env-file-if-exists=.env.local --tsconfig scripts/tsconfig.json scripts/modules-seed.ts",
    "mock:turso": "node --no-warnings scripts/mock-turso.mjs",
    "test:web-client": "node scripts/test-web-client.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:build": "opennextjs-cloudflare build",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "products:legacy": "tsx --env-file-if-exists=.env.local --tsconfig scripts/tsconfig.json scripts/products-legacy.ts",
    "templates:build": "tsx --tsconfig scripts/tsconfig.json scripts/build-templates.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@opennextjs/cloudflare": "^1.20.14",
    "gray-matter": "^4.0.3",
    "katex": "^0.19.1",
    "next": "16.4.3",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.154.0"
  }
}
