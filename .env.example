# Copy to .env.local for local work. In production set these in Vercel (Project > Settings > Environment Variables) or, for
# Cloudflare, with `npx wrangler secret put NAME` (secrets) / the `vars` in wrangler.jsonc (non-secret values).
# Placeholders only. NEVER commit real values.

# ---------------------------------------------------------------- public (safe to expose; baked into the build)
# The live address, used for canonical links, the sitemap, Open Graph tags and IndexNow. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://vierapparatus.com

# ---------------------------------------------------------------- database (server-side secrets)
# Turso (https://turso.tech): create a database, then `turso db show <name> --url` and `turso db tokens create <name>`.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------- authentication (server-side secret)
# A long random string (at least 32 characters), e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`.
# It is mixed into password hashes, CSRF tokens and anonymous visitor ids. Use the SAME value on every deployment (Vercel AND
# Cloudflare) and when you run `npm run admin:bootstrap`, otherwise passwords created in one place will not work in another.
AUTH_SECRET=

# ---------------------------------------------------------------- e-mail notifications (optional, server-side)
# Resend (https://resend.com). Without it, messages and proposals are still stored and shown in the admin area.
RESEND_API_KEY=
# Must be an address on your verified Resend domain.
INQUIRY_FROM_EMAIL="VierApparatus Website <noreply@vierapparatus.com>"
INQUIRY_TO_EMAIL=info@vierapparatus.com

# ---------------------------------------------------------------- images (Cloudflare R2)
# Uploaded images are converted to WebP in the admin's browser and stored in R2, filed under articles/, modules/, products/ and
# sponsors/ (thumbnails under thumbnails/). They are served from the public address below. With nothing configured, images stay in the
# database (fine for local development).
# On Cloudflare: bind the bucket as IMAGES in wrangler.jsonc (see the commented block there). No keys are needed.
# On Vercel, or on a PC against the real bucket: create an R2 API token with "Object Read & Write" for the bucket and set these four.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The public address of the bucket (a custom domain connected to it). Default: https://image.vierapparatus.com
IMAGE_PUBLIC_BASE_URL=https://image.vierapparatus.com

# ---------------------------------------------------------------- optional: shared rate limiting for page-view beacons
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------- local development only
# LOCAL_DB=1 and TURSO_DATABASE_URL=file:./.data/dev.db use a throw-away SQLite file instead of Turso (see README).

# Google AdSense publisher ID (ca-pub-...). Set it before building: it adds the verification script, the google-adsense-account meta tag and /ads.txt.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Show ads (keep "false" until a consent platform is in place, see components/ads/config.ts). Ad unit IDs are optional.
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_SLOT_VERTICAL=
NEXT_PUBLIC_ADSENSE_SLOT_SQUARE=
