{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker name. Appears in the default URL https://vierapparatus-cloudflare.<your-subdomain>.workers.dev
  "name": "vierapparatus-cloudflare",
  // custom-worker.ts wraps the generated .open-next/worker.js with the edge HTML cache.
  "main": "custom-worker.ts",
  // Must be 2024-09-23 or later for nodejs_compat (required by Next.js on Workers).
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Gives the Worker a per-deployment id, used in the edge-cache key so a new deploy never serves old HTML.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true },
  // IMAGES: uploaded article, module, product and sponsor pictures are stored in this R2 bucket from the Worker, with no keys needed.
  // Public links are IMAGE_PUBLIC_BASE_URL + the object key. The bucket is served on images.vierapparatus.com (R2 > bucket > Custom Domains).
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "vier-product-images" }],
  "vars": { "IMAGE_PUBLIC_BASE_URL": "https://images.vierapparatus.com" }
}
