# Cloudflare static-assets headers (copied into .open-next/assets by the build).
# Build output under /_next/static/ has a content hash in its file name, so it can be cached forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Logos and product placeholder images change rarely and keep the same URL: cache for a week.
/brand/*
  Cache-Control: public, max-age=604800
/images/*
  Cache-Control: public, max-age=604800
